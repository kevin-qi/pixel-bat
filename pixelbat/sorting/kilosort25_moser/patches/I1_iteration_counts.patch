I1. Convergence of the matching pursuit: CUDA/mexMPnu8.cu returns as 11th output the existing d_count (int32, nmaxiter = 500:
entry k+1 is the cumulative spike count of the batch after iteration k, entry 1 is 0, entries past nInnerIter+1 are 0).
The two callers store it per batch: rez.count_learn (columns in learning order, rez.iorig), rez.count_final (columns = batches).
Also stored: rez.Nfilt_learn (templates entering each learning batch; equals ops.Nfilt when the template cap bound) and rez.nInnerIter.

diff --git a/CUDA/mexMPnu8.cu b/CUDA/mexMPnu8.cu
index b3b7e4e..999a4cf 100644
--- a/CUDA/mexMPnu8.cu
+++ b/CUDA/mexMPnu8.cu
@@ -1145,6 +1145,10 @@ void mexFunction(int nlhs, mxArray *plhs[],
   cudaMemcpy(errmsg, d_errmsg, 1 * sizeof(int),   cudaMemcpyDeviceToHost);
   cudaFree(d_errmsg);
 
+  const mwSize dimCount[] 	= {nmaxiter,1};
+  plhs[10] 	= mxCreateNumericArray(2, dimCount, mxINT32_CLASS, mxREAL);
+  cudaMemcpy(mxGetData(plhs[10]), d_count, nmaxiter * sizeof(int), cudaMemcpyDeviceToHost);
+
   if (useStableMode) {
     //only free the memory if it was allocated
     cudaFree(d_draw64);
